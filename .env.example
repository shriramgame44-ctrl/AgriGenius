# ==========================================
# AgriGenius Enterprise Agronomy Platform
# Production & Deployment Environment Variables
# ==========================================

# Node Environment
NODE_ENV=production

# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Authentication & Security
JWT_SECRET=agrigenius_super_secret_jwt_key_2026_enterprise_agritech
JWT_EXPIRES_IN=7d

# Database Connection
# (Optional: If omitted, AgriGenius automatically uses embedded PostgreSQL WASM engine PGlite)
# DATABASE_URL=postgresql://user:password@host:5432/agrigenius

# Google Gemini AI API Key (Optional: for live generative crop diagnosis & AI voice chat)
GEMINI_API_KEY=

# Client / Frontend Origin URL
CLIENT_URL=http://localhost:5173
